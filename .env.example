# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# STT
STT_BACKEND=stub  # stub | faster-whisper
STT_MODEL=small
STT_DEVICE=cpu

# TTS (OpenTTS)
TTS_BACKEND=stub  # stub | opentts
OPENTTS_BASE_URL=http://localhost:5500
OPENTTS_VOICE=coqui-tts:en_vctk#p228

# Dialog
DIALOG_ENABLED=false

# Activation
ACTIVATION_MODE=ptt
ACTIVATION_PHRASE=эй, ассистент

# LLM
LLM_BACKEND=stub  # stub | proxy
LLM_ROUTING_MODE=priority  # priority | weighted
LLM_PRIMARY_PROVIDER=ollama  # openai | ollama
LLM_SECONDARY_PROVIDER=openai  # openai | ollama
LLM_PRIMARY_WEIGHT=1.0
LLM_SECONDARY_WEIGHT=0.0
LLM_TIMEOUT_S=20
LLM_MAX_RETRIES=2

# OpenAI-compatible
OPENAI_BASE_URL=https://api.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
